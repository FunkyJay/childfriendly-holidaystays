                    </div>							
                </div>
                
                <div class="qr-col">
                    <div class="qr-row">
                        <div class="qr-row-box" id="qr-row-box-2">
                            <div class="qr-date-box">
                            <div class="qr-date">21</div>
                                <div class="qr-month">Giu</div>
                            </div>
                        </div>	
                        <input type="text" id="TxtAl" name="TxtAl" class="TxtInput" value="" />
                    </div>							
                </div>
            
                <div class="qr-col qr-3">
                    <button type="button" class="qr-row-big transition" onclick="Javascript:send_request('en');">Request</button>
                    <a href="https://booking.dolcecasa.it/?skd-language-code=en" class="book-bt transition" target="_blank">Book</a>
